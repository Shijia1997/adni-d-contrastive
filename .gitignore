# Python/cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Logs and scheduler output
logs/
d_contrastive/logs/
*.out
*.err
slurm-*.out

# Local temporary / scratch outputs
tmp*/
tmp_*/
*_tmp/
.DS_Store

# External reference paper, do not commit/push
external_rank.pdf

# Model checkpoints and heavy intermediate arrays generated by training runs
*.pt
*.pth
*.pth.tar
*.ckpt

# Historical experiment output directories. Keep final consolidated CSV/XLSX
# summaries at d_contrastive/*.csv, *.xlsx, *.md tracked separately.
d_contrastive/results*/
d_contrastive/download_targets_20260515/

# Old one-off submit scripts from hyperparameter sweeps.
d_contrastive/submit_*.sh

# Large project data: ignore everything by default, then explicitly keep the
# compact frozen Swin embeddings and matched metadata needed to reproduce the
# contrastive experiments.
data/**
!data/
!data/embeddings_128_05152016/
!data/embeddings_128_05152016/**
!data/master_smri_05152016/
!data/master_smri_05152016/**

# Keep the contrastive package code and top-level consolidated results.
!d_contrastive/
!d_contrastive/*.py
!d_contrastive/*.sbatch
!d_contrastive/*.csv
!d_contrastive/*.xlsx
!d_contrastive/*.md
